@model List<AMAR.Application.Contract.HR.DTO.MedicationRequestDTO>
@{
    ViewBag.Title = "کارتابل انباردار";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var summary = ViewBag.MedicationSummary as List<AMAR.Application.Contract.HR.DTO.MedicationSummaryDTO> ?? new List<AMAR.Application.Contract.HR.DTO.MedicationSummaryDTO>();
    var totalUniqueMeds = summary.Count;
    var totalRequestsCount = summary.Sum(x => x.TotalRequests);
    var totalQtySum = summary.Sum(x => x.TotalQty);
}

<div class="container-fluid px-4">

    <!-- اعلان‌های عملیاتی -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show card-custom border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2 fs-5"></i>
            <strong>موفقیت:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show card-custom border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
            <strong>خطا:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show card-custom border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-info me-2 fs-5"></i>
            <strong>توجه:</strong> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ردیف کارت‌های آماری بالا -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card blue">
                <div>
                    <div class="stat-label">تعداد عناوین داروی درخواستی</div>
                    <div class="stat-value">@totalUniqueMeds</div>
                </div>
                <div class="stat-icon"><i class="fa-solid fa-capsules"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card emerald">
                <div>
                    <div class="stat-label">مجموع تعداد کل اقلام درخواستی</div>
                    <div class="stat-value">@totalQtySum</div>
                </div>
                <div class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card amber">
                <div>
                    <div class="stat-label">کل درخواست‌های در انتظار اسنپ‌شات</div>
                    <div class="stat-value">@totalRequestsCount</div>
                </div>
                <div class="stat-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
            </div>
        </div>
    </div>

    <!-- بخش اول: خلاصه تجمیعی تقاضای داروها و دکمه اسنپ‌شات -->
    <div class="card card-custom mb-4">
        <div class="card-header-custom">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-chart-pie text-primary fs-5"></i>
                <span>خلاصه تجمیعی داروها (تقاضای پرسنل تایید شده توسط پزشک)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("RemittanceArchive", "MedicationRequest")" class="btn btn-outline-primary btn-sm px-3 fw-bold shadow-sm">
                    <i class="fa-solid fa-box-archive ms-1"></i> آرشیو حواله‌ها و خروجی اکسل بسته‌بندی
                </a>
                @using (Html.BeginForm("TakeSnapshot", "MedicationRequest", FormMethod.Post, new { id = "snapshotForm", @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-warning btn-sm px-3 fw-bold shadow-sm" onclick="confirmSnapshot();">
                        <i class="fa-solid fa-camera ms-1"></i> ثبت Snapshot لحظه‌ای
                    </button>
                }
            </div>
        </div>
        <div class="card-body p-0">
            @if (summary.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-custom text-center align-middle">
                        <thead>
                            <tr>
                                <th>کد دارو</th>
                                <th class="text-end pe-4">نام دارو</th>
                                <th>تعداد درخواست‌ها</th>
                                <th>مجموع تعداد مورد نیاز</th>
                                <th>وضعیت تامین</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in summary)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-secondary border">@item.ProductId</span></td>
                                    <td class="text-end pe-4 fw-bold text-dark">@item.ProductName</td>
                                    <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">@item.TotalRequests درخواست</span></td>
                                    <td><span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fs-6">@item.TotalQty عدد</span></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary px-2 py-1">در صف انتظار</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-regular fa-folder-open fs-1 mb-2 d-block text-secondary"></i>
                    <span>هیچ داروی جدیدی در انتظار ثبت Snapshot وجود ندارد.</span>
                </div>
            }
        </div>
    </div>

    <!-- بخش دوم: رکوردهای Snapshot جاری جهت انتخاب و صدور حواله -->
    @using (Html.BeginForm("IssueRemittance", "MedicationRequest", FormMethod.Post, new { id = "issueForm" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="wfFieldId" value="@(ViewBag.DefaultWFFieldId ?? 101)" />

        <div class="card card-custom">
            <div class="card-header-custom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-file-invoice-dollar text-success fs-5"></i>
                    <span>اقلام موجود در Snapshot جاری جهت صدور حواله انبار</span>
                    <span id="selectedBadge" class="badge bg-primary px-3 py-1 rounded-pill">0 قلم انتخاب شده</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="text" id="tableSearch" class="form-control form-control-sm" placeholder="جستجوی سریع دارو..." style="width: 200px;" />
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" onclick="submitRemittance();">
                        <i class="fa-solid fa-check-double ms-1"></i> کشیدن حواله انبار برای انتخاب‌شده‌ها
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-custom text-center align-middle" id="snapTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">
                                        <input type="checkbox" id="selectAll" class="form-check-input" />
                                    </th>
                                    <th>ردیف</th>
                                    <th class="text-end pe-4">نام دارو</th>
                                    <th>تعداد درخواستی</th>
                                    <th>محل تحویل</th>
                                    <th>شماره فرآیند (WorkFlow)</th>
                                    <th>شناسه شخص</th>
                                    <th>سال / فصل</th>
                                    <th>تاریخ Snapshot</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var row = Model[i];
                                    <tr class="item-row">
                                        <td>
                                            <input type="checkbox" name="selectedUniqIds" value="@row.UniqId" class="form-check-input chk-item" onchange="updateCounter();" />
                                        </td>
                                        <td>@(i + 1)</td>
                                        <td class="text-end pe-4 fw-bold text-dark med-name">@row.productName</td>
                                        <td><span class="badge bg-info-subtle text-info-emphasis px-3 py-1">@row.Qty عدد</span></td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="fa-solid fa-location-dot text-danger ms-1"></i>
                                                @(string.IsNullOrEmpty(row.DeliveryLocation) ? "دبیرخانه مرکزی" : row.DeliveryLocation)
                                            </span>
                                        </td>
                                        <td><span class="font-monospace text-secondary">#@row.WorkFlowHdrId</span></td>
                                        <td><span class="badge bg-light text-secondary border">@row.PersonId</span></td>
                                        <td>@row.ShYear / @row.ShSeason</td>
                                        <td class="text-muted small">@row.SnapshotDateShamsi</td>
                                        <td>
                                            <span class="badge-status badge-snapshot">
                                                <i class="fa-solid fa-clock ms-1"></i> @row.StatusTitle
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-list-check fs-1 mb-2 d-block text-secondary"></i>
                        <span>هیچ دارویی در اسنپ‌شات فعلی وجود ندارد. لطفاً دکمه «ثبت Snapshot لحظه‌ای» را کلیک کنید.</span>
                    </div>
                }
            </div>
        </div>
    }

</div>

@section scripts {
<script>
    // انتخاب همه چک‌باکس‌ها
    var selectAllEl = document.getElementById('selectAll');
    if (selectAllEl) {
        selectAllEl.addEventListener('change', function () {
            var checkboxes = document.querySelectorAll('.chk-item');
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = this.checked;
            }
            updateCounter();
        });
    }

    // شمارنده رکوردهای انتخاب شده
    function updateCounter() {
        var count = document.querySelectorAll('.chk-item:checked').length;
        var badge = document.getElementById('selectedBadge');
        if (badge) {
            badge.innerText = count + ' قلم انتخاب شده';
            badge.className = count > 0 ? 'badge bg-success px-3 py-1 rounded-pill' : 'badge bg-secondary px-3 py-1 rounded-pill';
        }
    }

    // تایید و ثبت اسنپ شات
    function confirmSnapshot() {
        if (confirm('آیا از ثبت Snapshot لحظه‌ای برای تقاضاهای جدید اطمینان دارید؟\nاین عملیات وضعیت داروها را به حالت آماده صدور حواله تغییر می‌دهد.')) {
            document.getElementById('snapshotForm').submit();
        }
    }

    // تایید و صدور حواله
    function submitRemittance() {
        var count = document.querySelectorAll('.chk-item:checked').length;
        if (count === 0) {
            alert('لطفاً حداقل یک قلم دارو را برای صدور حواله انبار انتخاب فرمایید.');
            return;
        }

        if (confirm('آیا از صدور حواله برای ' + count + ' قلم داروی انتخاب شده اطمینان دارید؟\n\nنکات پشت پرده این عملیات:\n۱- وضعیت داروها به «حواله صادر شده» تغییر می‌یابد.\n۲- لیست داروها به ازای هر درخواست کننده الحاق (Append) می‌شود.\n۳- پیامک و ایمیل صدور حواله به پرسنل ارسال خواهد شد.')) {
            document.getElementById('issueForm').submit();
        }
    }

    // فیلتر سریع متنی در جدول
    var searchEl = document.getElementById('tableSearch');
    if (searchEl) {
        searchEl.addEventListener('keyup', function () {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('.item-row');
            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                var medNameEl = row.querySelector('.med-name');
                var medName = medNameEl ? medNameEl.innerText.toLowerCase() : '';
                row.style.display = medName.indexOf(filter) > -1 ? '' : 'none';
            }
        });
    }
</script>
}

@model List<AMAR.Application.Contract.HR.DTO.MedicationRequestDTO>
@{
    ViewBag.Title = "کارتابل دبیرخانه";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var filter = ViewBag.Filter as AMAR.Application.Contract.HR.DTO.SecretariatSearchFilterDTO ?? new AMAR.Application.Contract.HR.DTO.SecretariatSearchFilterDTO();
    var locations = ViewBag.Locations as List<string> ?? new List<string>();
    var totalMedsToDeliver = Model != null ? Model.Count : 0;
    var totalUniquePersons = Model != null ? Model.Select(x => x.PersonId).Distinct().Count() : 0;
}

<div class="container-fluid px-4">

    <!-- اعلان‌های عملیاتی -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show card-custom border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2 fs-5"></i>
            <strong>موفقیت:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show card-custom border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
            <strong>خطا:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ردیف کارت‌های آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="stat-card emerald">
                <div>
                    <div class="stat-label">تعداد اقلام دارویی حواله شده (آماده تحویل)</div>
                    <div class="stat-value">@totalMedsToDeliver</div>
                </div>
                <div class="stat-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="stat-card purple">
                <div>
                    <div class="stat-label">تعداد پرسنل منتظر دریافت دارو</div>
                    <div class="stat-value">@totalUniquePersons</div>
                </div>
                <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
            </div>
        </div>
    </div>

    <!-- فیلتر و جستجوی پرسنل مراجعه‌کننده -->
    <div class="card card-custom mb-4">
        <div class="card-header-custom">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-magnifying-glass text-primary fs-5"></i>
                <span>فیلتر و جستجوی پرسنل مراجعه‌کننده به دبیرخانه</span>
            </div>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Secretariat", "MedicationRequest", FormMethod.Get, new { @class = "row g-3 align-items-end", id = "searchForm" }))
            {
                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold small text-muted">کد پرسنلی:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-id-badge text-secondary"></i></span>
                        <input type="number" name="PersonelCode" class="form-control" value="@filter.PersonelCode" placeholder="مثال: 98123" />
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold small text-muted">نام و نام خانوادگی:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-user text-secondary"></i></span>
                        <input type="text" name="FullName" class="form-control" value="@filter.FullName" placeholder="نام یا نام خانوادگی پرسنل" />
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold small text-muted">محل تحویل دارو:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-building-circle-check text-secondary"></i></span>
                        <select name="DeliveryLocation" class="form-select">
                            <option value="">-- همه محل‌های تحویل --</option>
                            @foreach (var loc in locations)
                            {
                                <option value="@loc" @(loc == filter.DeliveryLocation ? "selected" : "")>@loc</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill fw-bold shadow-sm">
                        <i class="fa-solid fa-filter ms-1"></i> اعمال فیلتر
                    </button>
                    <a href="@Url.Action("Secretariat", "MedicationRequest")" class="btn btn-outline-secondary" title="حذف فیلترها">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- لیست اقلام حواله کشیده شده -->
    @using (Html.BeginForm("DeliverMedications", "MedicationRequest", FormMethod.Post, new { id = "deliveryForm" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="wfFieldId" value="@(ViewBag.DefaultWFFieldId ?? 102)" />

        <div class="card card-custom">
            <div class="card-header-custom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-hand-holding-medical text-success fs-5"></i>
                    <span>لیست داروهای حواله کشیده شده (آماده تحویل به پرسنل)</span>
                    <span id="delivBadge" class="badge bg-secondary px-3 py-1 rounded-pill">0 قلم انتخاب شده</span>
                </div>
                <div>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" onclick="submitDelivery();">
                        <i class="fa-solid fa-box-open ms-1"></i> ثبت تحویل به پرسنل
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-custom text-center align-middle" id="delivTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">
                                        <input type="checkbox" id="selectAllDeliv" class="form-check-input" />
                                    </th>
                                    <th>ردیف</th>
                                    <th>کد پرسنلی</th>
                                    <th class="text-end pe-4">نام و نام خانوادگی</th>
                                    <th class="text-end pe-4">نام دارو</th>
                                    <th>تعداد</th>
                                    <th>محل تحویل</th>
                                    <th>تاریخ کشیدن حواله</th>
                                    <th>صادرکننده حواله</th>
                                    <th>شماره فرآیند</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var item = Model[i];
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="selectedUniqIds" value="@item.UniqId" class="form-check-input chk-deliv" onchange="updateDelivCounter();" />
                                        </td>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1 font-monospace">@item.PersonelCode</span>
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-dark">
                                            <i class="fa-regular fa-user text-primary ms-1"></i>
                                            @item.FullName
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-dark">@item.productName</td>
                                        <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">@item.Qty عدد</span></td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="fa-solid fa-location-dot text-danger ms-1"></i>
                                                @(string.IsNullOrEmpty(item.DeliveryLocation) ? "دبیرخانه مرکزی" : item.DeliveryLocation)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-primary fw-semibold small">
                                                <i class="fa-regular fa-calendar-check ms-1"></i>
                                                @item.IssuedDateShamsi
                                            </span>
                                        </td>
                                        <td><span class="badge bg-light text-muted border">@item.IssuedBy</span></td>
                                        <td><span class="font-monospace text-secondary">#@item.WorkFlowHdrId</span></td>
                                        <td>
                                            <span class="badge-status badge-issued">
                                                <i class="fa-solid fa-receipt ms-1"></i> @item.StatusTitle
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-person-circle-question fs-1 mb-2 d-block text-secondary"></i>
                        <span>هیچ دارویی مطابق با شرایط فیلتر جستجو شده یافت نشد.</span>
                    </div>
                }
            </div>
        </div>
    }

</div>

@section scripts {
<script>
    var selectAllDelivEl = document.getElementById('selectAllDeliv');
    if (selectAllDelivEl) {
        selectAllDelivEl.addEventListener('change', function () {
            var checkboxes = document.querySelectorAll('.chk-deliv');
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = this.checked;
            }
            updateDelivCounter();
        });
    }

    function updateDelivCounter() {
        var count = document.querySelectorAll('.chk-deliv:checked').length;
        var badge = document.getElementById('delivBadge');
        if (badge) {
            badge.innerText = count + ' قلم انتخاب شده';
            badge.className = count > 0 ? 'badge bg-success px-3 py-1 rounded-pill' : 'badge bg-secondary px-3 py-1 rounded-pill';
        }
    }

    function submitDelivery() {
        var count = document.querySelectorAll('.chk-deliv:checked').length;
        if (count === 0) {
            alert('لطفاً حداقل یک قلم دارو را برای تحویل انتخاب فرمایید.');
            return;
        }

        if (confirm('آیا از ثبت تحویل برای ' + count + ' قلم داروی انتخاب شده به پرسنل اطمینان دارید؟\n\nنکات پشت پرده این عملیات:\n۱- وضعیت به «تحویل شده» تغییر می‌یابد.\n۲- اطلاعات تحویل در فیلد مربوطه فرم فرآیند ضمیمه (Append) می‌شود.\n۳- پیامک و ایمیل تایید تحویل برای همکار ارسال می‌گردد.')) {
            document.getElementById('deliveryForm').submit();
        }
    }
</script>
}
